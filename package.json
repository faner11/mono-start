{
  "name": "mono-start",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "author": "Bob",
  "type": "module",
  "scripts": {
    "check": "oxfmt && pnpm run check-type && pnpm run lint",
    "dev": "dotenvx run -- turbo dev",
    "build": "turbo build",
    "lint": "oxlint && turbo lint",
    "check-type": "turbo check-type",
    "db:push": "dotenvx run -- pnpm --filter @repo/common-server db:push",
    "db:generate": "dotenvx run -- pnpm --filter @repo/common-server db:generate",
    "db:migrate": "dotenvx run -- pnpm --filter @repo/common-server db:migrate",
    "auth-db:generate": "dotenvx run -- pnpm --filter @repo/common-server auth-db:generate",
    "fmt": "oxfmt",
    "prepare": "husky"
  },
  "dependencies": {
    "es-toolkit": "^1.47.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.2",
    "@repo/eslint-config": "workspace:*",
    "@tsconfig/bun": "^1.0.10",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260608.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.16"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint",
      "eslint"
    ]
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
